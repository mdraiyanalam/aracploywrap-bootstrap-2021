{
  "name": "aracploywrap-bootstrap-2021",
  "version": "1.0.0",
  "private": true,
  "description": "ARAC Polywrap Limited corporate website — static Bootstrap 5 build for GitHub Pages.",
  "license": "ISC",
  "author": "Md Raiyan Alam",
  "repository": {
    "type": "git",
    "url": "https://github.com/mdraiyanalam/aracploywrap-bootstrap-2021.git"
  },
  "homepage": "https://mdraiyanalam.github.io/aracploywrap-bootstrap-2021/",
  "scripts": {
    "start": "http-server src -p 8080 -c-1 -o",
    "lint": "npm run lint:html && npm run lint:css && npm run format:check",
    "lint:html": "html-validate \"src/**/*.html\"",
    "lint:css": "stylelint \"src/assets/css/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "html-validate": "^11.21.0",
    "http-server": "^14.1.1",
    "prettier": "^3.3.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^36.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
